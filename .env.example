# Borg Backup Manager - Environment Configuration

SECRET_KEY=your-secret-key-change-this

# Authentication
AUTH_DISABLED=true

# OIDC Configuration
OIDC_WELL_KNOWN_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile groups
OIDC_GROUPS_CLAIM=groups,roles
ALLOWED_GROUPS=

# Server
PORT=5001
DATABASE_URI=
SESSION_FILE_DIR=

# Scheduling
DAILY_VERIFICATION_ENABLED=true
DAILY_VERIFICATION_CRON=0 3 * * *

# Health & metrics
APP_VERSION=dev
METRICS_TOKEN=
BACKUP_MOUNT_REQUIRED=false
HEALTH_DEGRADED_HTTP_CODE=200
HEALTH_DEEP_BORG_CHECK=false
